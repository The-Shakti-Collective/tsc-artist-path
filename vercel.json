{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.theshakticollective.in/artist-path",
      "permanent": true
    }
  ]
}
